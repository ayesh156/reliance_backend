generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  STAFF
  CASHIER
  REP
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  PENDING
  PENDING_RECEIPT
  PAYMENT_REVIEW
  PAYMENT_VERIFIED
  PROCESSING
  SHIPPED
  DELIVERED
  PAID
  CANCELLED
}

enum OrderSource {
  ECOMMERCE
  POS_RETAIL
  POS_WHOLESALE
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  CONVERTED
  CANCELLED
}

// ----------------------------------------------------
// USERS & CUSTOMERS
// ----------------------------------------------------

model User {
  id                Int        @id @default(autoincrement())
  name              String
  email             String?    @unique
  phone             String?
  password          String     @default("")
  role              Role       @default(STAFF)
  permissions       String?    @db.LongText
  active            Boolean    @default(true)
  
  assignedCustomers Customer[] @relation("RepCustomers")
  createdOrders     Order[]    @relation("UserOrders")
  createdSalesOrders SalesOrder[] @relation("UserSalesOrders")

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  @@map("users")
}

model Customer {
  id                 Int          @id @default(autoincrement())
  type               CustomerType @default(RETAIL)
  name               String
  phone              String       @unique
  email              String?      @unique
  password           String?      // E-commerce login සඳහා
  address            String?
  city               String?
  photoUrl           String?
  outstandingBalance Float        @default(0)
  creditLimit        Float        @default(0)
  notes              String?      @db.Text
  nic                String?

  repId              Int?
  rep                User?        @relation("RepCustomers", fields: [repId], references: [id])

  orders             Order[]
  salesOrders        SalesOrder[] @relation("CustomerSalesOrders")
  // ⭐ Soft delete / Archive support: Keeps sales ledger history while hiding customer from UI
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([name])
  @@index([isActive])
  @@map("customers")
}

// ----------------------------------------------------
// PRODUCTS & VARIANTS (Fast POS Indexing & Search Keys)
// ----------------------------------------------------

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?   @db.LongText
  status      String    @default("active")
  products    Product[]
  // ⭐ Soft delete / Hide support: Preserves product relations without database constraint errors
  isActive    Boolean   @default(true)
  @@index([isActive])
  @@map("categories")
}

model Size {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("sizes")
}

model Color {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  hexCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("colors")
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String?          @unique
  description String?          @db.Text
  searchKey   String?          @db.VarChar(255) // ⭐ POS Search Keywords (e.g. "ts, polo, crew, shirt")
  categoryId  Int
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]
  images      ProductImage[]
  productionOrders ProductionOrder[]
  returnInventoryItems ReturnInventoryItem[]
  isFeatured  Boolean          @default(false)
  // ⭐ Soft delete / Archive support: Retains sales order lines while hiding from POS & Catalog
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([name])
  @@index([searchKey])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id             Int            @id @default(autoincrement())
  productId      Int
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String?
  color          String?
  sku            String         @unique          // ⭐ Barcode Scanner Scan Unit (e.g. "RL-001-M-BLK")
  barcode        String?        @unique          // ⭐ EAN/UPC Custom Barcode (Scan Target)
  costPrice      Float          @default(0)
  retailPrice    Float                           // POS Retail Unit Price
  wholesalePrice Float                           // Wholesale Rep Unit Price
  comparePrice   Float?                          // Strikethrough Price
  stock          Int            @default(0)
  
  images         ProductImage[]
  orderItems     OrderItem[]
  salesOrderItems SalesOrderItem[]
  productionOrders ProductionOrder[]
  returnInventoryItems ReturnInventoryItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sku])
  @@index([barcode])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id          Int             @id @default(autoincrement())
  productId   Int
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  imageUrl    String          @db.LongText
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  @@map("product_images")
}

// ----------------------------------------------------
// REVIEWS
// ----------------------------------------------------

model Review {
  id            Int           @id @default(autoincrement())
  productId     Int
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerName  String
  reviewerPhoto String?       @db.LongText
  description   String?       @db.Text
  rating        Int           @default(5)
  images        ReviewImage[]
  createdAt     DateTime      @default(now())
  @@map("reviews")
}

model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageUrl  String   @db.LongText
  @@map("review_images")
}

// ----------------------------------------------------
// ORDERS & PAYMENTS
// ----------------------------------------------------

model City {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  province    String?
  shippingFee Float    @default(0)
  @@map("cities")
}

model Order {
  id                Int           @id @default(autoincrement())
  invoiceNumber     String?       @unique // e.g. "INV-1001" or POS receipt identifier
  source            OrderSource   @default(ECOMMERCE)

  userId            Int?
  user              User?         @relation("UserOrders", fields: [userId], references: [id])
  
  customerId        Int?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  customerName      String?
  customerPhone     String?

  shippingAddress   String?       @db.Text
  city              String?
  province          String?
  shippingFee       Float         @default(0)
  totalAmount       Float
  subtotal          Float         @default(0)
  discount          Float         @default(0)
  discountType      String        @default("AMOUNT")
  discountValue     Float         @default(0)
  paidAmount        Float         @default(0)
  settledDueAmount  Float         @default(0)
  dueDate           DateTime?
  
  status            OrderStatus   @default(PENDING)
  paymentMethod     String?       // "COD", "CARD", "CASH", "CHEQUE", "bank-transfer"
  paymentReceiptUrl String?
  notes             String?       @db.Text
  
  // Rep Dispatch Tracking (Sent to sales rep / delivery tracking)
  isDispatched      Boolean       @default(false)
  dispatchedByRole  String?
  
  // Return Bill & Customer Return Credit Auto-Deduction & Cash Refunds
  isReturnBill        Boolean       @default(false)
  returnCreditApplied Float         @default(0)
  refundedCashAmount  Float         @default(0)

  items             OrderItem[]
  payments          OrderPayment[]
  salesOrder        SalesOrder?   @relation("SalesOrderInvoice")
  returnInventoryItems ReturnInventoryItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerPhone])
  @@index([status])
  @@index([invoiceNumber])
  @@index([isDispatched])
  @@index([isReturnBill])
  @@map("orders")
}

model OrderItem {
  id              Int            @id @default(autoincrement())
  orderId         Int
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       Int
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitPrice       Float          @default(0)
  discount        Float          @default(0)
  discountType    String         @default("AMOUNT")
  discountValue   Float          @default(0)
  price           Float
  isReturn        Boolean        @default(false)
  returnReason    String?        @default("UNSOLD")
  restockedToMain Boolean        @default(false)

  returnInventoryItems ReturnInventoryItem[]

  @@map("order_items")
}

model OrderPayment {
  id           Int           @id @default(autoincrement())
  orderId      Int
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount       Float
  method       String        // "CHEQUE", "CARD", "CASH"
  reference    String?       // Cheque No / Card Transaction ID
  chequeDate   DateTime?     // Cheque pass වෙන දිනය
  chequeStatus ChequeStatus? @default(PENDING)
  createdAt    DateTime      @default(now())
  @@map("order_payments")
}

// ----------------------------------------------------
// PRESALES ORDERS (Sales Representatives Presales Engine)
// ----------------------------------------------------

model SalesOrder {
  id              Int              @id @default(autoincrement())
  orderNumber     String?          @unique // e.g. "ORD-1001" or "SO-1001"
  
  userId          Int?
  user            User?            @relation("UserSalesOrders", fields: [userId], references: [id])
  
  customerId      Int?
  customer        Customer?        @relation("CustomerSalesOrders", fields: [customerId], references: [id])
  customerName    String?          // Snapshot for registered customer or name of on-the-fly guest customer
  customerPhone   String?
  customerAddress String?          @db.Text
  customerCity    String?
  
  subtotal        Float            @default(0)
  discount        Float            @default(0)
  discountType    String           @default("AMOUNT")
  discountValue   Float            @default(0)
  totalAmount     Float            @default(0)
  
  status          SalesOrderStatus @default(PENDING)
  notes           String?          @db.Text
  
  // Return Mode support
  isReturnOrder   Boolean          @default(false)
  
  // Future "Convert to Invoice" linkage
  invoiceId       Int?             @unique
  invoice         Order?           @relation("SalesOrderInvoice", fields: [invoiceId], references: [id])
  
  items           SalesOrderItem[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerPhone])
  @@index([status])
  @@index([orderNumber])
  @@index([customerId])
  @@index([userId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              Int             @id @default(autoincrement())
  salesOrderId    Int
  salesOrder      SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  
  variantId       Int?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  productName     String?
  variantName     String?
  sku             String?
  imageUrl        String?         @db.LongText
  
  quantity        Int             @default(1)
  unitPrice       Float           @default(0)
  discount        Float           @default(0)
  discountType    String          @default("AMOUNT")
  discountValue   Float           @default(0)
  totalPrice      Float           @default(0)
  isReturn        Boolean         @default(false)
  returnReason    String?         @default("UNSOLD")
  restockedToMain Boolean         @default(false)
  
  notes           String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([salesOrderId])
  @@index([variantId])
  @@map("sales_order_items")
}

// ----------------------------------------------------
// RETURN INVENTORY MANAGEMENT (Physical Return Stock Ledger)
// ----------------------------------------------------

model ReturnInventoryItem {
  id           Int             @id @default(autoincrement())
  orderId      Int?            @map("order_id")
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId  Int?            @map("order_item_id")
  orderItem    OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId    Int?            @map("product_id")
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    Int?            @map("variant_id")
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity     Int             @default(0)
  restockedQty Int             @default(0) @map("restocked_qty")
  reason       String          @default("UNSOLD") // "UNSOLD" or "DAMAGED"
  status       String          @default("IN_RETURN_STOCK") // "IN_RETURN_STOCK", "RESTOCKED", "SCRAPPED"
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@index([reason])
  @@map("return_inventory")
}

model Subscriber {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  subscribedAt  DateTime @default(now())
  @@map("subscribers")
}

// ----------------------------------------------------
// STOREFRONT SETTINGS (Key-Value Engine)
// ----------------------------------------------------

model StorefrontSetting {
  key       String   @id
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
  @@map("storefront_settings")
}

// ----------------------------------------------------
// RAW MATERIALS & MANUFACTURING ENGINE
// ----------------------------------------------------

enum RawMaterialUnit {
  METERS
  YARDS
  KILOGRAMS
  PCS
  ROLLS
  CONES
  PACKS
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  DUE
}

model RawMaterialShop {
  id             Int                  @id @default(autoincrement())
  name           String
  phone          String?              @db.Text
  address        String?              @db.Text
  contactPerson  String?
  creditBalance  Float                @default(0) // කඩයට ගෙවීමට ඇති හිඟ මුදල
  
  purchases      BuyRawMaterial[]
  payments       SupplierPayment[]    // ⭐ Added relation to track supplier due debt payments
  // ⭐ Soft delete / Deactivate support: Preserves purchase orders and debt audit logs
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([name])
  @@index([isActive])
  @@map("raw_material_shops")
}

model RawMaterialItem {
  id              Int                  @id @default(autoincrement())
  name            String
  code            String?              @unique // Item Code (e.g. RM-DNM-001)
  description     String?              @db.Text
  unit            RawMaterialUnit      @default(METERS)
  currentStock    Float                @default(0) // වත්මන් තොග ශේෂය
  alertThreshold  Float                @default(10) // අඩු වූ විට Alert දෙන අවම සීමාව
  unitCostAverage Float                @default(0) // සාමාන්‍ය මිලදී ගැනීමේ මිල (Weighted Average Cost)

  purchaseItems   BuyRawMaterialItem[]
  movements       RawMaterialMovement[] // ⭐ Added relation to track usage, scrap return, and wastage
  productionUsages ProductionMaterialUsage[]
  cutLogs         MaterialCutLog[]
  materialLogs    MaterialLog[]
  cutAmount       Float                @default(0) @map("cut_amount")
  remainingAmount Float                @default(0) @map("remaining_amount")
  // ⭐ Soft delete / Archive support: Retains stock movement ledger and GRN logs
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([name])
  @@index([isActive])
  @@map("raw_material_items")
}

model BuyRawMaterial {
  id                  Int                  @id @default(autoincrement())
  invoiceNumber       String?              // කඩෙන් ලැබෙන බිල්පත් අංකය (Supplier Invoice No)
  rawMaterialShopId   Int                  @map("raw_material_shop_id")
  shop                RawMaterialShop      @relation(fields: [rawMaterialShopId], references: [id], onDelete: Cascade)
  
  totalAmount         Float                @map("price") // Total bill amount
  paidAmount          Float                @default(0)   // ගෙවූ මුදල
  paymentMethod       String?              @default("CASH") // CASH, CREDIT, CHEQUE, BANK_TRANSFER
  paymentStatus       PurchasePaymentStatus @default(PAID)
  
  purchaseDate        DateTime             @map("purchase_date")
  notes               String?              @db.Text
  
  items               BuyRawMaterialItem[]
  payments            SupplierPayment[]    // ⭐ Added opposite relation for supplier invoice payments
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([rawMaterialShopId])
  @@index([purchaseDate])
  @@map("buy_raw_materials")
}

model BuyRawMaterialItem {
  id                Int             @id @default(autoincrement())
  buyRawMaterialId  Int             @map("buy_raw_material_id")
  buyRawMaterial    BuyRawMaterial  @relation(fields: [buyRawMaterialId], references: [id], onDelete: Cascade)
  
  rawMaterialItemId Int             @map("raw_material_item_id")
  rawMaterialItem   RawMaterialItem @relation(fields: [rawMaterialItemId], references: [id], onDelete: Cascade)
  
  quantity          Float           // ප්‍රමාණය (Meters, Kg, etc.)
  pricePerUnit      Float           @map("price_per_unit")
  rowTotal          Float           @map("row_total") // quantity * pricePerUnit
  
  batchNumber       String?         // Roll No හෝ Lot No
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([buyRawMaterialId])
  @@index([rawMaterialItemId])
  @@map("buy_raw_material_items")
}


// ----------------------------------------------------
// RAW MATERIAL MOVEMENTS & SUPPLIER PAYMENTS
// ----------------------------------------------------

enum MaterialMovementType {
  STOCK_IN        // Initial purchase from supplier
  PRODUCTION_USE  // Deducted for garment cutting/production
  SCRAP_RETURN    // Leftover/unused scrap returned back to warehouse
  DAMAGE_WASTE    // Damaged/wasted materials written off
  AUDIT_ADJUST    // Stock count correction
}

model RawMaterialMovement {
  id                Int                  @id @default(autoincrement())
  rawMaterialItemId Int                  @map("raw_material_item_id")
  rawMaterialItem   RawMaterialItem      @relation(fields: [rawMaterialItemId], references: [id], onDelete: Cascade)
  
  movementType      MaterialMovementType @map("movement_type")
  quantity          Float                // Amount moved (Meters, Kg, etc.)
  previousStock     Float                @map("previous_stock") // Stock balance before
  newStock          Float                @map("new_stock")      // Stock balance after
  reference         String?              @db.Text               // Reason/Batch/Style notes
  recordedBy        Int?                 @map("recorded_by")
  
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([rawMaterialItemId])
  @@index([movementType])
  @@index([createdAt])
  @@map("raw_material_movements")
}

model SupplierPayment {
  id                 Int              @id @default(autoincrement())
  rawMaterialShopId  Int              @map("raw_material_shop_id")
  shop               RawMaterialShop  @relation(fields: [rawMaterialShopId], references: [id], onDelete: Cascade)
  
  buyRawMaterialId   Int?             @map("buy_raw_material_id")
  buyRawMaterial     BuyRawMaterial?  @relation(fields: [buyRawMaterialId], references: [id], onDelete: SetNull)
  
  amount             Float            // Paid amount (Rs.)
  paymentMethod      String           @default("CASH") @map("payment_method") // CASH, CHEQUE, BANK_TRANSFER
  reference          String?          // Cheque No / Bank Slip
  paymentDate        DateTime         @default(now()) @map("payment_date")
  
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([rawMaterialShopId])
  @@index([buyRawMaterialId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

// ----------------------------------------------------
// GARMENT PRODUCTION & MATERIAL CONSUMPTION
// ----------------------------------------------------

model ProductionOrder {
  id              Int                       @id @default(autoincrement())
  productionNo    String                    @unique @map("production_no")
  productId       Int                       @map("product_id")
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       Int?                      @map("variant_id")
  variant         ProductVariant?           @relation(fields: [variantId], references: [id], onDelete: SetNull)
  targetQuantity  Int                       @default(0) @map("target_quantity")
  completedQty    Int                       @default(0) @map("completed_qty")
  status            String                    @default("CUTTING")
  isStockSynced     Boolean                   @default(false) @map("is_stock_synced")
  stockSyncedAt     DateTime?                 @map("stock_synced_at")
  stockSyncedByRole String?                   @map("stock_synced_by_role")
  reason            String?                   @db.Text
  notes             String?                   @db.Text
  productionDate    DateTime                  @default(now()) @map("production_date")
  targetProducts    String?                   @db.LongText @map("target_products")
  lineSentQty       Int?                      @default(0) @map("line_sent_qty")
  cutQty            Int                       @default(0) @map("cut_qty")
  sewnQty           Int                       @default(0) @map("sewn_qty")
  sentToWashQty     Int                       @default(0) @map("sent_to_wash_qty")
  washedQty         Int                       @default(0) @map("washed_qty")
  
  materialUsages  ProductionMaterialUsage[]
  cutLogs         MaterialCutLog[]
  materialLogs    MaterialLog[]
  finishLogs      GarmentFinishLog[]
  activityLogs    BatchActivityLog[]
  
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@index([productId])
  @@index([variantId])
  @@index([productionDate])
  @@index([productionNo])
  @@index([isStockSynced])
  @@map("production_orders")
}

model ProductionMaterialUsage {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterialId     Int             @map("raw_material_id")
  rawMaterial       RawMaterialItem @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  
  issuedQty         Float           @map("issued_qty")
  returnedQty       Float           @default(0) @map("returned_qty")
  returnedScrap     Float?          @default(0) @map("returned_scrap")
  netConsumedQty    Float           @map("net_consumed_qty")
  cutAmount         Float           @default(0) @map("cut_amount")
  remainingAmount   Float           @default(0) @map("remaining_amount")
  processDate       DateTime        @default(now()) @map("process_date")
  unitCost          Float           @default(0) @map("unit_cost")
  returnReason      String?         @map("return_reason") @db.Text
  piecesCount       Int?            @default(1) @map("pieces_count")
  targetProducts    String?         @db.LongText @map("target_products")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([productionOrderId])
  @@index([rawMaterialId])
  @@map("production_material_usages")
}

model MaterialCutLog {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterialId     Int             @map("raw_material_id")
  rawMaterial       RawMaterialItem @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  
  quantityCut       Float           @map("quantity_cut")
  cutDate           DateTime        @default(now()) @map("cut_date")
  loggedByRole      String?         @map("logged_by_role")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([productionOrderId])
  @@index([rawMaterialId])
  @@index([cutDate])
  @@map("material_cut_logs")
}

model GarmentFinishLog {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  
  quantityFinished  Int             @map("quantity_finished")
  isSyncedToStock   Boolean         @default(false) @map("is_synced_to_stock")
  syncedAt          DateTime?       @map("synced_at")
  finishDate        DateTime        @default(now()) @map("finish_date")
  loggedByRole      String?         @map("logged_by_role")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([productionOrderId])
  @@index([finishDate])
  @@index([isSyncedToStock])
  @@map("garment_finish_logs")
}

model BatchActivityLog {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  
  stage             String          @default("CUTTING")
  action            String          @default("INITIAL_CUT")
  notes             String?         @db.Text
  timestamp         DateTime        @default(now())
  userId            Int?            @map("user_id")
  userName          String?         @map("user_name")
  quantity          Float           @default(0)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([productionOrderId])
  @@index([stage])
  @@index([timestamp])
  @@map("batch_activity_logs")
}

// ----------------------------------------------------
// MATERIAL LOGS (Production Fabric & Material Tracking)
// ----------------------------------------------------

model MaterialLog {
  id                Int              @id @default(autoincrement())
  productionOrderId Int?             @map("production_order_id")
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  rawMaterialId     Int              @map("raw_material_id")
  rawMaterial       RawMaterialItem  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  
  cutAmount         Float            @default(0) @map("cut_amount")
  remainingAmount   Float            @default(0) @map("remaining_amount")
  wasteAmount       Float            @default(0) @map("waste_amount")
  unitCost          Float            @default(0) @map("unit_cost")
  processDate       DateTime         @default(now()) @map("process_date")
  batchNumber       String           @default("") @map("batch_number")
  notes             String?          @db.Text
  loggedByRole      String           @default("STAFF") @map("logged_by_role")
  
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([productionOrderId])
  @@index([rawMaterialId])
  @@index([processDate])
  @@map("material_logs")
}