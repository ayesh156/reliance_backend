{
  "name": "reliance-backend",
  "version": "1.0.0",
  "description": "Reliance — Retail & Wholesale POS + E-Commerce backend API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npx prisma generate && tsup src/index.ts --format esm --platform node --target node24 --out-dir dist --sourcemap --clean --no-splitting",
    "start:prod": "node dist/index.ts",
    "start": "node dist/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "npx prisma db seed",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
